{
  "name": "crackers-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:setup": "tsx --env-file-if-exists=.env scripts/setup-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "create-admin": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "reconcile": "tsx --env-file-if-exists=.env scripts/reconcile-status.ts",
    "sample-catalogue": "tsx --env-file-if-exists=.env scripts/sample-catalogue.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "drizzle-orm": "^0.38.4",
    "next": "^15.1.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
