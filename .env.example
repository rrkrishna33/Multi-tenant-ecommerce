DATABASE_URL=postgres://crackers_app:CHANGE_ME@localhost:5432/crackers
PLATFORM_DOMAIN=yourplatform.com

# Shown to clients on the shop detail page as the A record target
SERVER_IP=

# Where product images are written. Caddy serves this directory directly.
UPLOAD_DIR=/var/lib/crackers/uploads

# Optional: a Unicode TTF (e.g. Noto Sans Tamil) so estimate PDFs can render
# Tamil product names. Without it PDFs use Helvetica and Tamil glyphs are dropped.
PDF_FONT_PATH=
