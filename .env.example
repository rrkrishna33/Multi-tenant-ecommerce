# Copy to .env and fill in. .env is gitignored and holds the only copy of these
# secrets -- back it up somewhere safe before you deploy.
#
# Generate each password and the session secret with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# ---------------------------------------------------------------------------
# Database: three roles, on purpose
# ---------------------------------------------------------------------------

# The app's connection. MUST be the unprivileged `crackers_app` role.
#
# That role owns no tables, so FORCE ROW LEVEL SECURITY applies to it and a
# query that forgets its tenant returns zero rows instead of another shop's
# orders. Point this at `postgres` and every isolation policy silently stops
# working -- the app keeps running and looks completely normal while serving one
# shop's data to another. This is the single most damaging line in the file.
DATABASE_URL=postgres://crackers_app:CHANGE_ME@localhost:5432/crackers

# Sign-in and platform admin. The `crackers_platform` role, which is BYPASSRLS.
#
# Sign-in has to find a user by email BEFORE it knows their tenant, and under
# RLS with no tenant context that lookup returns nothing -- so every login
# fails. Leave this unset and the code falls back to DATABASE_URL, which
# reintroduces exactly that bug: the server starts, the storefront works, and
# nobody can log in.
PLATFORM_DATABASE_URL=postgres://crackers_platform:CHANGE_ME@localhost:5432/crackers

# A superuser connection, used ONLY by `npm run db:setup` (which creates the two
# roles above and applies the policies) and `npm run seed`. The running app
# never touches it. Keeping it separate means DATABASE_URL never has to be
# temporarily pointed at `postgres` -- a swap that is easy to forget to undo.
SUPERUSER_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/crackers

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Your own domain. Routing uses it to tell your platform pages from a shop's
# storefront: this host serves /platform and marketing, everything else is
# resolved as a tenant (a <slug>.PLATFORM_DOMAIN subdomain, or a client's own
# custom domain). Locally this is localhost:3000.
PLATFORM_DOMAIN=yourplatform.com

# HMAC key for login cookies. At least 32 characters, or the app throws on
# startup. Changing it signs every session out; leaking it lets someone forge a
# session for any shop -- or for your platform admin.
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

# Shown to clients on the shop detail page as the A record target for their
# domain.
SERVER_IP=

# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------

# Where product and About photos are written. In production Caddy serves this
# directory straight from disk, so Node never touches the read path.
#
# Must be a path the OS understands: on Windows use C:/Users/you/project/var/uploads,
# NOT a Git Bash path like /c/Users/... -- Node reads that as a folder called
# "c" at the root of the current drive and writes your uploads there.
# Leave unset in development to use <project>/var/uploads.
UPLOAD_DIR=/var/lib/crackers/uploads

# Optional: a Unicode TTF (e.g. Noto Sans Tamil) so estimate PDFs can render
# Tamil product names. Without it PDFs use Helvetica, which drops Tamil glyphs
# silently. The storefront and HTML estimates show Tamil either way.
PDF_FONT_PATH=

# ---------------------------------------------------------------------------
# Rarely needed
# ---------------------------------------------------------------------------

# Comma-separated hostnames allowed to post Server Actions, for the case where
# something in front rewrites the Host header (a CDN, a tunnel). Same-origin
# submissions pass without this, so leave it empty behind Caddy.
SERVER_ACTION_ORIGINS=

# Overrides the build output directory. Dev and production already use separate
# ones (.next-dev and .next) so `npm run build` and `npm run dev` can never
# corrupt each other's output -- set this only to run a second build alongside a
# live server.
NEXT_DIST_DIR=
